{
  "name": "@pakiso/example-api",
  "version": "1.0.3",
  "private": true,
  "description": "Example NestJS API demonstrating Pakiso: a durable user-onboarding workflow with email-verification and compliance-approval attestation gates.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:sqlite": "prisma generate --schema=prisma/schema.prisma",
    "pretest": "pnpm generate:sqlite",
    "prebuild": "pnpm generate:sqlite",
    "prestart": "pnpm generate:sqlite",
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pakiso/core": "workspace:*",
    "@pakiso/dashboard": "workspace:*",
    "@pakiso/nest": "workspace:*",
    "@pakiso/storage-prisma": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "@prisma/client": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
