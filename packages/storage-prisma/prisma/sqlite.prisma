// Causal storage schema — SQLite dialect.
// Kept byte-for-byte identical in model shape to postgresql.prisma and
// mysql.prisma (only `datasource`/`generator` differ) so the generated
// TypeScript client types — and therefore PrismaStorageAdapter — are
// interchangeable across dialects.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/sqlite"
}

datasource db {
  provider = "sqlite"
  url      = env("CAUSAL_DATABASE_URL")
}

model CausalRun {
  id             String   @id @default(uuid(7))
  workflowName   String
  correlationKey String?
  idempotencyKey String?
  status         String
  input          Json
  output         Json?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events CausalEvent[]

  @@unique([workflowName, idempotencyKey])
  @@index([workflowName, correlationKey])
  @@map("causal_runs")
}

model CausalEvent {
  id         String   @id @default(uuid())
  runId      String
  seq        Int
  type       String
  stepName   String?
  durationMs Int?
  payload    Json
  createdAt  DateTime @default(now())

  run CausalRun @relation(fields: [runId], references: [id])

  @@unique([runId, seq])
  @@map("causal_events")
}
