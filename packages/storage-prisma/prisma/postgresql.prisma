// Pakiso storage schema — PostgreSQL dialect.
// Kept byte-for-byte identical in model shape to sqlite.prisma and
// mysql.prisma (only `datasource`/`generator` differ) so the generated
// TypeScript client types — and therefore PrismaStorageAdapter — are
// interchangeable across dialects.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/postgresql"
}

datasource db {
  provider = "postgresql"
  url      = env("PAKISO_DATABASE_URL")
}

model PakisoRun {
  id             String   @id @default(uuid(7))
  workflowName   String
  correlationKey String?
  idempotencyKey String?
  status         String
  input          Json
  output         Json?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  /// Distributed execution lease (Phase 4): the worker/replica id currently
  /// processing this run, and when that claim expires. Null when unleased.
  lockedBy       String?
  leaseExpiresAt DateTime?
  /// Deadline for the attestation gate currently being awaited (Phase 4:
  /// auto-escalation). Null unless status is WAITING_ATTESTATION with a deadline.
  attestationExpiresAt DateTime?

  events PakisoEvent[]

  @@unique([workflowName, idempotencyKey])
  @@index([workflowName, correlationKey])
  @@index([status, attestationExpiresAt])
  @@map("pakiso_runs")
}

model PakisoEvent {
  id         String   @id @default(uuid())
  runId      String
  seq        Int
  type       String
  stepName   String?
  durationMs Int?
  payload    Json
  createdAt  DateTime @default(now())

  run PakisoRun @relation(fields: [runId], references: [id])

  @@unique([runId, seq])
  @@map("pakiso_events")
}
