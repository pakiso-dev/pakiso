{
  "name": "causal",
  "private": true,
  "description": "Causal — a stateful, deterministic, auditable execution framework for Node.js and NestJS",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "release": "turbo run build && changeset publish",
    "docs:dev": "pnpm --filter @causal/docs dev",
    "docs:build": "pnpm --filter @causal/docs build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.11",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  }
}
